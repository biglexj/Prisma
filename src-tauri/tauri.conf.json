{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisma",
  "version": "0.0.1",
  "identifier": "com.biglexj.prisma",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prisma · Multimedia local",
        "width": 960,
        "height": 680,
        "minWidth": 360,
        "minHeight": 520,
        "center": true
      },
      {
        "label": "quicklook",
        "title": "Prisma Quick Look",
        "width": 760,
        "height": 500,
        "minWidth": 460,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/libmpv/bin/libmpv-2.dll": "./"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "aac",
          "m4a",
          "ogg",
          "opus",
          "wma",
          "m3u",
          "m3u8"
        ],
        "name": "Archivo de Audio",
        "description": "Archivo de audio para reproductor Prisma",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "webm",
          "flv",
          "wmv",
          "m4v"
        ],
        "name": "Archivo de Vídeo",
        "description": "Archivo de vídeo para visor Prisma",
        "role": "Viewer"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "gif",
          "bmp",
          "svg"
        ],
        "name": "Archivo de Imagen",
        "description": "Archivo de imagen para visor Prisma",
        "role": "Viewer"
      }
    ]
  }
}
